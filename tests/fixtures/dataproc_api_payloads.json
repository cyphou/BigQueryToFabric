        "jobId": "spark-streaming-consumer-003"
      },
      "placement": {
        "clusterName": "ml-training-cluster"
      },
      "sparkJob": {
        "mainJarFileUri": "gs://dataproc-staging-bucket-001/jars/streaming-consumer.jar",
        "args": [
          "pubsub-subscription-id",
          "bigquery.table(`demo-project.analytics.events_stream`)"
