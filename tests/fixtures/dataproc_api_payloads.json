      "driverControlsFilesUri": "gs://dataproc-staging-bucket-001/driver-controls",
      "labels": {
        "workflow": "daily-etl",
        "dataset": "events"
      }
    },
    {
      "reference": {
        "projectId": "demo-project",
        "jobId": "spark-sql-aggregation-002"
      },
      "placement": {
        "clusterName": "ml-training-cluster"
      },
      "sparkSqlJob": {
        "queryList": {
          "queries": [
            "CREATE TEMPORARY VIEW staging AS SELECT * FROM bigquery.table(`demo-project.raw.events`)",
            "INSERT INTO bigquery.table(`demo-project.analytics.daily_revenue`) SELECT date, SUM(amount) FROM staging GROUP BY date"
          ]
        },
        "jarFileUris": [
          "gs://dataproc-staging-bucket-001/jars/spark-bigquery.jar"
        ]
      },
      "status": {
        "state": "DONE",
        "stateStartTime": "2024-09-21T09:00:00Z"
      },
