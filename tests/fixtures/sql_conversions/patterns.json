    {
      "name": "cte_with_union",
      "description": "Common Table Expression with UNION",
      "source_sql": "WITH recent_orders AS (\n  SELECT order_id, customer_id, amount\n  FROM orders\n  WHERE created_at > DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)\n),\nall_orders AS (\n  SELECT order_id, customer_id, amount\n  FROM orders\n)\nSELECT * FROM recent_orders\nUNION ALL\nSELECT * FROM all_orders WHERE customer_id NOT IN (SELECT customer_id FROM recent_orders)",
      "patterns": ["cte", "union", "select"],
      "conversions": {
        "tsql": {
          "expected_contains": ["WITH", "UNION ALL"],
          "compatibility": "direct",
          "warnings": []
        },
        "spark_sql": {
          "expected_contains": ["WITH", "UNION"],
          "compatibility": "direct",
          "warnings": []
        },
        "pyspark": {
          "expected_contains": ["WITH", "UNION"],
          "compatibility": "direct",
          "warnings": []
        }
      }
    },
    {
      "name": "qualify_clause",
      "description": "QUALIFY clause for window function filtering",
      "source_sql": "SELECT order_id, customer_id, ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY order_date) as rn\nFROM orders\nQUALIFY rn <= 3",
      "patterns": ["select", "window_functions", "qualify"],
      "conversions": {
        "tsql": {
          "expected_contains": ["OVER", "PARTITION BY"],
          "compatibility": "transform",
          "warnings": ["QUALIFY requires manual translation"]
        },
        "spark_sql": {
          "expected_contains": ["OVER"],
          "compatibility": "transform",
          "warnings": ["QUALIFY clause detected"]
        },
        "pyspark": {
          "expected_contains": ["OVER"],
          "compatibility": "transform",
          "warnings": []
        }
      }
