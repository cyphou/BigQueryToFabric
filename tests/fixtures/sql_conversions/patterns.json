{
  "patterns": [
    {
      "name": "simple_select",
      "description": "Simple SELECT with WHERE, GROUP BY, ORDER BY, LIMIT",
      "source_sql": "SELECT user_id, COUNT(*) as order_count\nFROM orders\nWHERE created_at > '2024-01-01'\nGROUP BY user_id\nORDER BY order_count DESC\nLIMIT 10",
      "patterns": ["select", "group_by", "order_by", "limit"],
      "conversions": {
        "tsql": {
          "expected_contains": ["SELECT", "COUNT(*)", "WHERE", "GROUP BY", "ORDER BY", "LIMIT"],
          "compatibility": "direct",
          "warnings": []
        },
        "spark_sql": {
          "expected_contains": ["SELECT", "COUNT(*)", "WHERE", "GROUP BY", "ORDER BY", "LIMIT"],
          "compatibility": "direct",
          "warnings": []
        },
        "pyspark": {
          "expected_contains": ["SELECT", "COUNT", "WHERE", "GROUP BY", "ORDER BY"],
          "compatibility": "direct",
          "warnings": []
        }
      }
    },
    {
      "name": "select_with_joins",
      "description": "SELECT with multiple JOINs",
      "source_sql": "SELECT o.order_id, c.customer_name, p.product_name\nFROM orders o\nINNER JOIN customers c ON o.customer_id = c.id\nLEFT JOIN products p ON o.product_id = p.id\nWHERE o.status = 'completed'",
      "patterns": ["select", "joins", "multi_join"],
      "conversions": {
        "tsql": {
          "expected_contains": ["SELECT", "INNER JOIN", "LEFT JOIN"],
          "compatibility": "direct",
          "warnings": []
        },
        "spark_sql": {
          "expected_contains": ["SELECT", "INNER JOIN", "LEFT JOIN"],
          "compatibility": "direct",
          "warnings": []
        },
        "pyspark": {
          "expected_contains": ["SELECT", "JOIN"],
          "compatibility": "direct",
          "warnings": []
        }
      }
    },
    {
      "name": "unnest_array",
      "description": "UNNEST with array operations",
      "source_sql": "SELECT order_id, item\nFROM orders\nCROSS JOIN UNNEST(items) as item",
      "patterns": ["select", "unnest", "array_operations"],
      "conversions": {
        "tsql": {
          "expected_contains": ["CROSS APPLY"],
          "compatibility": "transform",
          "warnings": ["UNNEST requires translation to CROSS APPLY"]
        },
        "spark_sql": {
          "expected_contains": ["explode"],
          "compatibility": "transform",
          "warnings": ["UNNEST in Spark SQL should use explode"]
        },
        "pyspark": {
          "expected_contains": ["explode"],
          "compatibility": "transform",
          "warnings": []
        }
      }
    },
    {
      "name": "struct_extraction",
      "description": "Struct field extraction",
      "source_sql": "SELECT order_id, item.sku, item.quantity\nFROM orders,\nUNNEST(items) as item",
      "patterns": ["select", "struct_types", "unnest"],
      "conversions": {
        "tsql": {
          "expected_contains": ["JSON"],
          "compatibility": "transform",
          "warnings": ["Struct types require mapping to T-SQL JSON"]
        },
        "spark_sql": {
          "expected_contains": ["explode"],
          "compatibility": "transform",
          "warnings": []
        },
        "pyspark": {
          "expected_contains": ["explode"],
          "compatibility": "transform",
          "warnings": []
        }
      }
    },
    {
      "name": "window_functions",
      "description": "Window functions with OVER and PARTITION BY",
      "source_sql": "SELECT order_id, amount,\n  SUM(amount) OVER (PARTITION BY customer_id ORDER BY order_date) as running_total,\n  ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY order_date) as order_seq\nFROM orders",
      "patterns": ["select", "window_functions", "window_with_partition"],
      "conversions": {
        "tsql": {
          "expected_contains": ["OVER", "PARTITION BY", "ROW_NUMBER"],
          "compatibility": "direct",
          "warnings": []
        },
        "spark_sql": {
          "expected_contains": ["OVER", "PARTITION BY", "ROW_NUMBER"],
          "compatibility": "direct",
          "warnings": []
        },
        "pyspark": {
          "expected_contains": ["OVER"],
          "compatibility": "transform",
          "warnings": []
        }
      }
    },
